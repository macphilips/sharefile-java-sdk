#!/usr/bin/env bash
set -euo pipefail

if command -v node >/dev/null 2>&1; then
    exec node "$@"
fi

for candidate in \
    /Applications/Codex.app/Contents/Resources/node \
    /opt/homebrew/bin/node \
    /usr/local/bin/node
do
    if [[ -x "${candidate}" ]]; then
        exec "${candidate}" "$@"
    fi
done

echo "Unable to locate node. Install Node.js or add node to PATH." >&2
exit 1
