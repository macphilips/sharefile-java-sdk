#!/usr/bin/env bash
set -euo pipefail

if command -v npm >/dev/null 2>&1; then
    exec npm "$@"
fi

if [[ -n "${SPOTLESS_NPM_CLI:-}" && -f "${SPOTLESS_NPM_CLI}" ]]; then
    exec node "${SPOTLESS_NPM_CLI}" "$@"
fi

find_npm_cli() {
    local search_root
    for search_root in /opt/homebrew /usr/local; do
        if [[ -d "${search_root}" ]]; then
            local candidate
            candidate="$(find "${search_root}" -path "*/node_modules/npm/bin/npm-cli.js" -print -quit 2>/dev/null || true)"
            if [[ -n "${candidate}" ]]; then
                printf '%s\n' "${candidate}"
                return 0
            fi
        fi
    done

    return 1
}

npm_cli="$(find_npm_cli || true)"
if [[ -n "${npm_cli}" && -f "${npm_cli}" ]]; then
    exec node "${npm_cli}" "$@"
fi

echo "Unable to locate npm. Install npm or set SPOTLESS_NPM_CLI to an npm-cli.js path." >&2
exit 1
